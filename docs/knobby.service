# Systemd user service for the knobby MIDI controller daemon.
# Live copy: ~/.config/systemd/user/knobby.service
# Manage with:
#   systemctl --user enable --now knobby
#   systemctl --user status knobby
#   journalctl --user -u knobby -f

[Unit]
Description=Knobby MIDI controller daemon
After=graphical-session.target pipewire.service

[Service]
RuntimeDirectory=knobby
RuntimeDirectoryMode=0700
ExecStart=%h/.local/share/knobby/current/bin/knobby
Restart=always
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
