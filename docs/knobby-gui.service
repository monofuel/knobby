[Unit]
Description=Knobby tray viewer
After=graphical-session.target knobby.service
PartOf=graphical-session.target
Wants=knobby.service

[Service]
RuntimeDirectory=knobby-gui
RuntimeDirectoryMode=0700
ExecStart=%h/.local/share/knobby/current/bin/knobby-gui --background
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
