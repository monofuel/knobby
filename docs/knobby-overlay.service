[Unit]
Description=Knobby mixer help overlay
After=graphical-session.target knobby.service
PartOf=graphical-session.target

# The daemon starts this unit on a Help press; it has no [Install] section, so it
# never starts at login and stays running hidden between requests.
[Service]
RuntimeDirectory=knobby-overlay
RuntimeDirectoryMode=0700
ExecStart=%h/.local/share/knobby/current/bin/knobby-overlay
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
